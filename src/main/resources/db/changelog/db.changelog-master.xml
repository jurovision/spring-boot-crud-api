<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.4.xsd">
    <changeSet author="Justus" id="1">
        <createTable tableName="product">
            <column name="id" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="product_pkey"/>
            </column>
            <column name="name" type="VARCHAR(255)"/>
            <column name="type" type="VARCHAR(255)"/>
            <column name="created_by" type="VARCHAR(64)"/>
            <column name="created_at" type="TIMESTAMP"/>
        </createTable>
                <createTable tableName="coins">
            <column name="id" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="coins_pkey"/>
            </column>
            <column name="ten_Cent_Coins" type="INT"/>
            <column name="twenty_Cent_Coins" type="INT"/>
            <column name="fifty_Cent_Coins" type="INT"/>
            <column name="one_Euro_Coins" type="INT"/>
            <column name="two_Euro_Coins" type="INT"/>
        </createTable>
    </changeSet>
</databaseChangeLog>